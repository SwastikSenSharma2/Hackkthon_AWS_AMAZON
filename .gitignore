# ==========================================
# Data & Datasets (Confidential / Large Files)
# ==========================================
DATA/
data/
*.zip
*.tar.gz
*.7z
*.csv
*.txt
!requirements.txt
*.json
*.geojson
*.pkl
*.parquet

# Keep config JSON/YAML files
!config/**/*.json
!config/**/*.yaml
!config/**/*.yml
!package.json
!tsconfig.json

# ==========================================
# Generated Outputs & Artifacts
# ==========================================
processed/
output/*
!output/*.py
!output/results_writer.py
!output/.gitkeep

